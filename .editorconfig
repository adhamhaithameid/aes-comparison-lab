root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,hpp,h,c}]
indent_style = space
indent_size = 4

[*.{js,jsx,ts,ts}]
indent_style = space
indent_size = 2

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{sh,bash}]
indent_style = space
indent_size = 4

[*.py]
indent_style = space
indent_size = 4

[*.{html,css}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
